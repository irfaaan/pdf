# ============================================
# Telegram Configuration
# ============================================
# Bot token from @BotFather — REQUIRED
TELEGRAM_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Channel/group username (with @) or numeric chat id where signals are posted — REQUIRED
CHANNEL_ID=@your_channel

# Optional separate bot/channel per module (fall back to TELEGRAM_TOKEN / CHANNEL_ID)
TELEGRAM_GOLD_BOT_TOKEN=
TELEGRAM_GOLD_CHANNEL_ID=

# Numeric admin chat id for crash/error notifications (optional; defaults to CHANNEL_ID)
ADMIN_CHAT_ID=

# ============================================
# Exchanges
# ============================================
# Comma-separated enabled exchanges. Supported: mexc, okx, bitget, gate, weex, binance, bybit, kucoin
ENABLED_EXCHANGES=mexc
PRIMARY_EXCHANGE=mexc

# Gold symbol in ccxt unified form (swap = XAU/USDT:USDT, spot = XAU/USDT)
GOLD_SYMBOL=XAU/USDT:USDT

# Optional per-exchange API keys (public market data works without them)
MEXC_API_KEY=
MEXC_API_SECRET=

# ============================================
# AI / OpenRouter (optional signal vetting)
# ============================================
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_1=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ============================================
# Runtime toggles (can be changed live via Telegram commands)
# ============================================
GOLD_ENABLED=true
MEME_ENABLED=false
CHARTS_ENABLED=true
AI_ENABLED=true
BROADCAST_ENABLED=true
TRACKING_ENABLED=true
ERROR_NOTIFICATIONS=true

# ============================================
# Scalping Engine — XAU/USDT
# ============================================
# Timeframes to scan (comma separated)
TIMEFRAMES=1m,5m,15m
# How often to poll the exchange (seconds)
POLL_INTERVAL_SECONDS=15
# Minimum pause between two signals of the same direction on the same timeframe (minutes)
SIGNAL_COOLDOWN_MINUTES=10
# Minimum combined confidence score (0-100) before a setup is notified
MIN_SIGNAL_SCORE=65
# Minimum number of strategies that must agree on the same direction
MIN_CONFLUENCE_STRATEGIES=2

# --- Indicator parameters ---
EMA_FAST=9
EMA_MID=21
EMA_SLOW=50
RSI_PERIOD=14
ATR_PERIOD=14
BB_PERIOD=20
BB_STD=2.0
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
STOCH_K=14
STOCH_D=3
DONCHIAN_PERIOD=20
VOLUME_SMA_PERIOD=20
VWAP_DEV_ATR=1.8

# --- Risk / trade plan ---
SL_ATR_MULT=1.5
TP_ATR_MULT=2.5
MAX_CANDLES=500

# --- Strategy toggles ---
STRATEGY_EMA_PULLBACK=true
STRATEGY_VWAP_REVERSION=true
STRATEGY_BREAK_RETEST=true
STRATEGY_ORDER_BLOCK=true
STRATEGY_MACD_MOMENTUM=true
STRATEGY_RSI_DIVERGENCE=true

# --- Filters ---
# Suppress signals during high-impact news windows (UTC, "HH:MM-HH:MM", comma separated).
# Defaults cover US CPI/NFP (08:30 ET) and FOMC (14:00 ET) in both DST variants.
NEWS_BLACKOUT_ENABLED=true
NEWS_BLACKOUT_WINDOWS=12:30-13:45,13:30-14:45,18:00-19:30
# Do not trade on weekends (thin liquidity). true/false
WEEKEND_FILTER=false

# --- Misc ---
LOG_LEVEL=INFO
